{
  "name": "operon-validation-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:deterministic": "vitest run --config vitest.config.ts specs/layer-1 specs/layer-2",
    "test:sandbox": "vitest run --config vitest.config.ts specs/layer-3",
    "eval:qualify": "vitest run --config vitest.config.ts specs/layer-4",
    "eval:episode-planner": "node --import tsx src/cli/run-episode-planner-campaign.ts",
    "eval:episode-planner:qualification": "node --import tsx src/cli/run-episode-planner-campaign.ts --stage qualification",
    "eval:episode-planner:qualification:audit": "node --import tsx src/cli/audit-episode-planner-qualification.ts",
    "eval:episode-planner:audit": "node --import tsx src/cli/audit-episode-planner-campaign.ts",
    "eval:episode-planner:followup": "node --import tsx src/cli/prepare-episode-planner-followup.ts",
    "eval:episode-planner:diagnostic": "node --import tsx src/cli/run-episode-planner-diagnostic.ts",
    "eval:episode-planner:l4-003:prepare": "node --import tsx src/cli/prepare-episode-planner-l4-003.ts",
    "eval:episode-planner:l4-003:diagnostic": "node --import tsx src/cli/run-episode-planner-diagnostic.ts --campaign OPERON-L4-003",
    "eval:episode-planner:l4-003:diagnostic:audit": "node --import tsx src/cli/audit-episode-planner-diagnostic.ts --campaign OPERON-L4-003",
    "eval:episode-planner:l4-003:qualification": "node --import tsx src/cli/run-episode-planner-campaign.ts --stage qualification --campaign OPERON-L4-003",
    "eval:episode-planner:l4-003:qualification:audit": "node --import tsx src/cli/audit-episode-planner-qualification.ts --campaign OPERON-L4-003",
    "eval:episode-planner:l4-004:prepare": "node --import tsx src/cli/prepare-episode-planner-l4-003.ts --campaign OPERON-L4-004",
    "eval:episode-planner:l4-004:diagnostic": "node --import tsx src/cli/run-episode-planner-diagnostic.ts --campaign OPERON-L4-004",
    "eval:episode-planner:l4-004:diagnostic:audit": "node --import tsx src/cli/audit-episode-planner-diagnostic.ts --campaign OPERON-L4-004",
    "eval:episode-planner:l4-004:qualification": "node --import tsx src/cli/run-episode-planner-campaign.ts --stage qualification --campaign OPERON-L4-004",
    "eval:episode-planner:l4-004:qualification:audit": "node --import tsx src/cli/audit-episode-planner-qualification.ts --campaign OPERON-L4-004",
    "eval:episode-planner:l4-005:prepare": "node --import tsx src/cli/prepare-episode-planner-l4-003.ts --campaign OPERON-L4-005",
    "eval:episode-planner:l4-005:diagnostic": "node --import tsx src/cli/run-episode-planner-diagnostic.ts --campaign OPERON-L4-005",
    "eval:episode-planner:l4-005:diagnostic:audit": "node --import tsx src/cli/audit-episode-planner-diagnostic.ts --campaign OPERON-L4-005",
    "eval:episode-planner:l4-005:qualification": "node --import tsx src/cli/run-episode-planner-campaign.ts --stage qualification --campaign OPERON-L4-005",
    "eval:episode-planner:l4-005:qualification:audit": "node --import tsx src/cli/audit-episode-planner-qualification.ts --campaign OPERON-L4-005",
    "eval:episode-planner:diagnostic:audit": "node --import tsx src/cli/audit-episode-planner-diagnostic.ts",
    "test:ops": "vitest run --config vitest.config.ts specs/layer-5",
    "validate:local": "node --import tsx src/cli/validate-local.ts"
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "26.1.0",
    "fast-check": "4.9.0",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  }
}
