{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "operon.eval.result.v1",
  "type": "object",
  "required": ["schema_version", "campaign_id", "campaign_sha256", "attempt_id", "case_id", "repetition_id", "outcome", "admitted_at", "terminal_at", "evidence", "metrics", "exclusions", "missing"],
  "properties": {
    "schema_version": { "const": 1 },
    "campaign_id": { "type": "string", "minLength": 1 },
    "campaign_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "attempt_id": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "repetition_id": { "type": "string", "minLength": 1 },
    "outcome": { "enum": ["passed", "product_miss", "safety_stop", "budget_stop", "infra_invalid", "harness_error", "not_run"] },
    "admitted_at": { "type": ["string", "null"], "format": "date-time" },
    "terminal_at": { "type": ["string", "null"], "format": "date-time" },
    "evidence": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^(episode|run|github|artifact|grader|approval|git|provider|harness|fixture):[^\\s]+$" } },
    "metrics": {
      "type": "object",
      "required": ["route", "context", "cost", "tokens", "latency", "human_load", "productivity", "continuation", "approvals", "scheduler", "learning", "execution"],
      "properties": {
        "route": { "type": "object" },
        "context": { "type": "object" },
        "cost": { "type": "object" },
        "tokens": { "type": "object" },
        "latency": { "type": "object" },
        "human_load": { "type": "object" },
        "productivity": { "type": "object" },
        "continuation": { "type": "object" },
        "approvals": { "type": "object" },
        "scheduler": { "type": "object" },
        "learning": { "type": "object" },
        "execution": { "type": "object" },
        "capabilities": { "type": "object" },
        "soak": { "type": "object" }
      },
      "additionalProperties": false
    },
    "exclusions": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "missing": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "retry_of": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
