{
  "name": "operon",
  "version": "0.1.0",
  "private": true,
  "description": "Org runtime: a standing team of AI agents developing a product via a private GitHub repo, human-gated on critical ops only",
  "type": "module",
  "bin": {
    "operon": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "e2e:sandbox": "tsx test/e2e/sandboxLoop.ts",
    "e2e:sandbox:setup": "bash scripts/setup-sandbox-repo.sh",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.201",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@11.10.0"
}
