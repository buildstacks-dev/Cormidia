{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "operon.eval.operator-fixture.v1",
  "type": "object",
  "required": ["schema_version", "fixture_id", "actor_kind", "scripted_layers", "live_decision_mode", "decisions", "forbidden_effects"],
  "properties": {
    "schema_version": { "const": 1 },
    "fixture_id": { "type": "string", "pattern": "^[a-z0-9-]+/v[0-9]+$" },
    "actor_kind": { "enum": ["separate_eval_operator", "human_operator"] },
    "scripted_layers": { "type": "array", "uniqueItems": true, "items": { "enum": ["L2", "L4"] } },
    "live_decision_mode": { "const": "human_required" },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "action_sha256", "decision", "scope"],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "action_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "decision": { "enum": ["allow_eval_effect_recorder_once", "deny_and_park"] },
          "scope": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "forbidden_effects": { "type": "array", "minItems": 7, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
