{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "operon.eval.grader.v1",
  "type": "object",
  "required": ["id", "source", "reference", "mutants", "content_sha256", "hidden_marker_sha256"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/v[0-9]+$" },
    "source": { "type": "string", "pattern": "^graders/.+\\.ts$" },
    "reference": { "type": "string", "pattern": "^graders/.+" },
    "mutants": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^graders/.+" } },
    "content_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "hidden_marker_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
