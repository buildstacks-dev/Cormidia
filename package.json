{
  "name": "cormidia",
  "version": "0.1.1",
  "private": false,
  "description": "Org runtime: a standing team of AI agents developing a product via a private GitHub repo, human-gated on critical ops only",
  "homepage": "https://github.com/cormidia/cormidia-web",
  "bugs": {
    "url": "https://github.com/cormidia/cormidia-web/issues"
  },
  "type": "module",
  "bin": {
    "cormidia": "./src/cormidia.cjs",
    "cormidia-job": "./src/cormidia-job.cjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/cormidia.cjs",
    "src/cormidia-job.cjs",
    "src/cormidia-local.cjs",
    "src/cormidia-job-local.cjs",
    "dist/**/*.js",
    "dist/**/*.json",
    "agent-skills/cormidia/",
    "agent-skills/cormidia-job/",
    "config/launchd/",
    "docs/policy.yaml.template",
    "docs/scheduler/design.md",
    "docs/qualification/validation-triage.md",
    "prompts/",
    "taste/",
    "TASTE.md",
    "roles.yaml",
    "pipelines.yaml",
    "README.md",
    "scripts/link-local.mjs",
    "scripts/link-skills.mjs",
    "scripts/lib/install-ownership.mjs",
    "scripts/lib/install-transaction.mjs",
    "scripts/lib/link-artifacts.mjs",
    "scripts/cormidia-local.mjs",
    "scripts/cormidia-job-local.mjs",
    "scripts/smoke-onboarding.mjs",
    "scripts/release-verify.mjs",
    "scripts/smoke-package-install.mjs"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "build:watch": "tsc --watch --preserveWatchOutput",
    "check": "biome check --error-on-warnings . && pnpm typecheck && node scripts/check-pinned-deps.mjs && node scripts/check-import-direction.mjs && node scripts/check-size-ratchet.mjs && node scripts/check-type-ratchet.mjs",
    "ci:runner": "node scripts/self-hosted-runner/cli.mjs",
    "dev": "tsx src/cli.ts",
    "harness:freshness": "node scripts/harness-freshness.mjs",
    "install:packaged": "node scripts/install-packaged.mjs",
    "link:local": "node scripts/link-local.mjs",
    "link:skills": "node scripts/link-skills.mjs",
    "prepack": "pnpm build",
    "prepare": "node scripts/install-git-hooks.mjs",
    "prepublishOnly": "pnpm release:verify",
    "release:verify": "node scripts/release-verify.mjs",
    "smoke:onboarding": "pnpm build && node scripts/smoke-onboarding.mjs",
    "smoke:package": "node scripts/smoke-package-install.mjs",
    "test": "bash scripts/test.sh",
    "test:acceptance": "tsx tests/campaign/acceptance/campaign-entry.ts",
    "test:eval": "tsx tests/eval-runner/cli.ts",
    "test:live": "vitest run --config tests/live/vitest.config.ts",
    "test:soak": "tsx tests/ops/soak-cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "worktree": "tsx scripts/worktree.ts"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.224",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@openai/codex": "0.147.0",
    "@opencode-ai/sdk": "1.18.15",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "26.1.0",
    "fast-check": "4.9.0",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "validation-architect": "file:vendor/validation-architect-0.1.1.tgz",
    "vitest": "3.2.6"
  },
  "packageManager": "pnpm@11.10.0"
}
