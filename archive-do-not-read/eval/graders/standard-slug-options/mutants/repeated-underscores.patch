diff --git a/src/slug.js b/src/slug.js
--- a/src/slug.js
+++ b/src/slug.js
@@ -1,3 +1,5 @@
-export function slug(value) {
-  return String(value).trim().toLowerCase().replaceAll(/[^a-z0-9]+/g, "-").replaceAll(/^-|-$/g, "");
+export function slug(value, options = {}) {
+  const separator = options.preserveUnderscores ? "_" : "-";
+  const disallowed = options.preserveUnderscores ? /[^a-z0-9_]+/g : /[^a-z0-9]+/g;
+  return String(value).trim().toLowerCase().replaceAll(disallowed, separator).replaceAll(new RegExp(`^${separator}|${separator}$`, "g"), "");
 }
