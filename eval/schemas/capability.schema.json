{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "operon.eval.capability.v1",
  "type": "object",
  "required": ["schema_version", "capability_id", "runtime", "task_transport", "large_payload", "gate_top_level", "gate_delegated", "tool_events", "cancellation", "partial_usage_checkpoint", "session_continuation", "budget_enforcement", "cost_quality", "cache_visibility", "role_shaping", "intra_turn_fanout", "known_gaps"],
  "properties": {
    "schema_version": { "const": 1 },
    "capability_id": { "pattern": "^(claude|codex|pi)/v[0-9]+$" },
    "runtime": { "enum": ["claude", "codex", "pi"] },
    "task_transport": { "type": "string", "minLength": 1 },
    "large_payload": { "type": "boolean" },
    "gate_top_level": { "type": "string", "minLength": 1 },
    "gate_delegated": { "type": "string", "minLength": 1 },
    "tool_events": { "type": "string", "minLength": 1 },
    "cancellation": { "type": "string", "minLength": 1 },
    "partial_usage_checkpoint": { "type": "boolean" },
    "session_continuation": { "type": "string", "minLength": 1 },
    "budget_enforcement": { "type": "string", "minLength": 1 },
    "cost_quality": { "enum": ["reported", "estimated", "partial", "unavailable"] },
    "cache_visibility": { "type": "string", "minLength": 1 },
    "role_shaping": { "type": "string", "minLength": 1 },
    "intra_turn_fanout": { "type": "string", "minLength": 1 },
    "known_gaps": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
