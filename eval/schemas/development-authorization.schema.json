{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "operon.eval.development-authorization.v1",
  "type": "object",
  "required": [
    "schema_version",
    "authorization_id",
    "policy_id",
    "objective",
    "repair_lineage",
    "authorized_at",
    "billing_mode",
    "cumulative_equivalent_cost_usd",
    "historical_equivalent_cost_usd",
    "allowed_campaign_types",
    "github",
    "effects",
    "learning_activation",
    "future_realtime_soak",
    "stop_conditions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "authorization_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$" },
    "policy_id": { "const": "autonomous-isolated-development-v1" },
    "objective": { "type": "string", "minLength": 1 },
    "repair_lineage": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$" },
    "authorized_at": { "type": "string", "format": "date-time" },
    "billing_mode": { "const": "subscription" },
    "cumulative_equivalent_cost_usd": { "type": "number", "exclusiveMinimum": 0 },
    "historical_equivalent_cost_usd": { "type": "number", "minimum": 0 },
    "usage_reservations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["campaign_id", "reason", "equivalent_cost_usd"],
        "properties": {
          "campaign_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "reason": { "const": "usage_unavailable_case_ceiling" },
          "equivalent_cost_usd": { "type": "number", "exclusiveMinimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "proportionate_release": {
      "type": "object",
      "required": [
        "policy",
        "base_candidate_commit",
        "bounded_changed_paths",
        "max_fresh_full_campaigns",
        "adapter",
        "focused"
      ],
      "properties": {
        "policy": { "const": "proportionate-release-v1" },
        "base_candidate_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "bounded_changed_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(?!/)(?![.][.]/).+$" }
        },
        "max_fresh_full_campaigns": { "const": 1 },
        "adapter": { "$ref": "#/$defs/retainedAdmission" },
        "focused": { "$ref": "#/$defs/retainedAdmission" }
      },
      "additionalProperties": false
    },
    "allowed_campaign_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*-v[0-9]+$" }
    },
    "github": {
      "type": "object",
      "required": ["owner", "repo_pattern"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "repo_pattern": { "const": "operon-eval-*" }
      },
      "additionalProperties": false
    },
    "effects": {
      "type": "object",
      "required": ["production_mutation", "outward_effects", "deployment", "publication"],
      "properties": {
        "production_mutation": { "const": false },
        "outward_effects": { "const": false },
        "deployment": { "const": false },
        "publication": { "const": false }
      },
      "additionalProperties": false
    },
    "learning_activation": { "const": "separately_authorized" },
    "future_realtime_soak": { "const": "separately_authorized" },
    "stop_conditions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "cumulative_equivalent_cost_ceiling",
          "metered_or_unknown_billing",
          "scope_or_effect_expansion",
          "repeated_full_qualification_failure"
        ]
      },
      "allOf": [
        { "contains": { "const": "cumulative_equivalent_cost_ceiling" } },
        { "contains": { "const": "metered_or_unknown_billing" } },
        { "contains": { "const": "scope_or_effect_expansion" } },
        { "contains": { "const": "repeated_full_qualification_failure" } }
      ]
    }
  },
  "$defs": {
    "retainedAdmission": {
      "type": "object",
      "required": ["campaign_id", "campaign_sha256"],
      "properties": {
        "campaign_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "campaign_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
